#!/usr/bin/env python3
"""
LPES - Local Production Environment Simulator
Root entry point for command-line interface.

This script provides easy access to LPES from the root directory.
"""

import sys
import os
from pathlib import Path

# Add src directory to Python path
root_dir = Path(__file__).parent
src_dir = root_dir / "src"
sys.path.insert(0, str(src_dir))

try:
    from lpes.cli.main import cli
    
    if __name__ == '__main__':
        cli()
        
except ImportError as e:
    print(f"❌ Error importing LPES: {e}")
    print("📋 Solutions:")
    print("  1. Run: pip install -r requirements.txt")
    print("  2. Run: pip install -e .")
    print(f"  3. Run from: {src_dir / 'main.py'}")
    sys.exit(1)
except Exception as e:
    print(f"💥 Fatal error: {e}")
    sys.exit(1)
