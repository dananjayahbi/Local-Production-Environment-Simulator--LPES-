#!/usr/bin/env python3
"""
LPES GUI Launcher
Root entry point for graphical user interface.

This script provides easy access to LPES GUI from the root directory.
"""

import sys
import os
from pathlib import Path

# Add gui and src directories to Python path
root_dir = Path(__file__).parent
gui_dir = root_dir / "gui"
src_dir = root_dir / "src"
sys.path.extend([str(gui_dir), str(src_dir)])

def main():
    """Launch LPES GUI with error handling."""
    try:
        # Try enhanced GUI first
        from lpes_gui_enhanced import main as gui_main
        print("🚀 Launching LPES GUI Manager Pro...")
        gui_main()
        
    except ImportError:
        try:
            # Fallback to basic GUI
            from lpes_gui import main as gui_main
            print("🚀 Launching LPES GUI Manager...")
            gui_main()
            
        except ImportError as e:
            print(f"❌ Error importing LPES GUI: {e}")
            print("📋 Solutions:")
            print("  1. Install tkinter: pip install tk")
            print("  2. Run: pip install -r requirements.txt")
            print("  3. Check Python includes tkinter")
            return 1
            
    except Exception as e:
        print(f"💥 GUI error: {e}")
        return 1
        
    return 0

if __name__ == '__main__':
    sys.exit(main())
